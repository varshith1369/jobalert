datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id         Int      @id @default(autoincrement())
  name       String
  shortName  String   @unique
  websiteUrl String
  logoUrl    String?
  createdAt  DateTime @default(now())
  jobs       Job[]
}

model Location {
  id           Int      @id @default(autoincrement())
  stateCode    String // e.g., 'UP', 'MH', 'DL', 'ALL_INDIA'
  stateName    String
  cityDistrict String?
  isAllIndia   Boolean  @default(false)
  createdAt    DateTime @default(now())
  jobs         Job[]
}

model Job {
  id                 String       @id @default(uuid())
  organizationId     Int
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title              String
  slug               String       @unique
  notificationNumber String?
  category           String // 'CENTRAL_GOVT' | 'STATE_GOVT' | 'BANKING' | 'DEFENCE' | 'TEACHING' | 'RAILWAYS' | 'PRIVATE'
  minEducation       String // 'EIGHTH_PASS' | 'TENTH_PASS' | 'TWELFTH_PASS' | 'DIPLOMA' | 'GRADUATE' | 'POST_GRADUATE'
  locationId         Int?
  location           Location?    @relation(fields: [locationId], references: [id])
  totalVacancies     Int?
  salaryMin          Float?
  salaryMax          Float?
  salaryCurrency     String       @default("INR")

  postDate DateTime
  deadline DateTime
  examDate DateTime?

  sourceType        String // 'SCRAPER' | 'API' | 'MANUAL'
  officialSourceUrl String
  officialPdfUrl    String?
  rawContentSummary String

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions  UserJobInteraction[]
  notifications NotificationLog[]

  @@index([isActive, postDate])
  @@index([isActive, deadline])
  @@index([category, minEducation])
}

model CrawlerSource {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  baseUrl       String
  parserType    String // 'CHEERIO' | 'PLAYWRIGHT' | 'API'
  scheduleCron  String
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastDomHash   String?
  status        String    @default("HEALTHY") // 'HEALTHY' | 'DEGRADED' | 'FAILING'
  itemsFound    Int       @default(0)
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  createdAt    DateTime @default(now())

  preference    UserPreference?
  interactions  UserJobInteraction[]
  notifications NotificationLog[]
}

model UserPreference {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredEducation   String   @default("GRADUATE")
  preferredCategories  String   @default("[]") // JSON string of category codes
  preferredStates      String   @default("[]") // JSON string of state codes
  emailDigestFrequency String   @default("DAILY") // 'OFF' | 'DAILY' | 'WEEKLY'
  pushSubscription     String? // JSON string of Web Push subscription
  telegramChatId       String?
  updatedAt            DateTime @updatedAt
}

model UserJobInteraction {
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  isSaved   Boolean  @default(false)
  status    String   @default("SAVED") // 'SAVED' | 'APPLIED' | 'DISMISSED'
  updatedAt DateTime @updatedAt

  @@id([userId, jobId])
}

model NotificationLog {
  id      Int      @id @default(autoincrement())
  userId  String
  jobId   String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  channel String // 'PUSH' | 'EMAIL' | 'TELEGRAM'
  sentAt  DateTime @default(now())

  @@unique([userId, jobId, channel])
}
